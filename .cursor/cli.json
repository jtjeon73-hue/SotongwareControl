{
  "permissions": {
    "allow": [
      "Shell(ls)",
      "Shell(dir)",
      "Shell(where)",
      "Shell(where.exe)",
      "Shell(echo)",
      "Shell(type)",
      "Shell(cat)",
      "Shell(Get-ChildItem)",
      "Shell(Get-Content)",
      "Shell(Select-String)",
      "Shell(rg)",
      "Shell(findstr)",
      "Shell(git:status*)",
      "Shell(git:diff*)",
      "Shell(git:log*)",
      "Shell(git:show*)",
      "Shell(git:rev-parse*)",
      "Shell(git:branch*)",
      "Shell(git:fetch*)",
      "Shell(git:remote*)",
      "Shell(flutter)",
      "Shell(dart)",
      "Shell(npm)",
      "Shell(npx)",
      "Shell(node)",
      "Shell(python)",
      "Shell(python3)",
      "Shell(py)",
      "Shell(pytest)",
      "Shell(cmake)",
      "Shell(ctest)",
      "Shell(msbuild)",
      "Shell(dotnet)",
      "Read(**)",
      "WebFetch(docs.cursor.com)",
      "WebFetch(cursor.com)",
      "WebFetch(*.github.com)",
      "WebFetch(github.com)",
      "WebFetch(firebase.google.com)",
      "WebFetch(*.web.app)"
    ],
    "deny": [
      "Shell(rm)",
      "Shell(rmdir)",
      "Shell(del)",
      "Shell(Remove-Item)",
      "Shell(git:push*)",
      "Shell(git:reset*)",
      "Shell(git:clean*)",
      "Shell(git:rebase*)",
      "Shell(git:filter*)",
      "Shell(firebase:deploy*)",
      "Shell(firebase:use*)",
      "Shell(gh:secret*)",
      "Read(.env*)",
      "Read(**/.env*)",
      "Write(**/.env*)",
      "Write(**/*.key)",
      "Write(**/*credential*)",
      "Write(**/*secret*)"
    ]
  }
}
